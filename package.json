{
  "name": "tfc-whatsapp-service",
  "version": "1.0.0",
  "description": "Production-Ready WhatsApp Automation Microservice for The Foundation Collegiate (TFC) Portal",
  "main": "dist/src/server.js",
  "scripts": {
    "vercel-build": "prisma generate && tsc -p tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "start:worker": "node dist/worker/worker.js",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch worker/worker.ts",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "test": "tsx tests/runAllTests.ts",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "whatsapp",
    "tfc",
    "baileys",
    "fastify",
    "bullmq",
    "redis",
    "prisma",
    "supabase"
  ],
  "author": "The Foundation Collegiate",
  "license": "MIT",
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.9",
    "@prisma/client": "^5.22.0",
    "@supabase/supabase-js": "^2.48.1",
    "bullmq": "^5.34.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.2",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "qrcode": "^1.5.4",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.17.19",
    "@types/qrcode": "^1.5.5",
    "prisma": "^5.22.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
